# Copy to .env.local (or a deploy env file) and fill in your FilixPay credentials.
# Never commit .env.local — keep secrets out of git.
# Production builds require explicit URLs — there are no filixpay.com defaults in code.

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000/auth-api/auth
NEXTAUTH_SECRET=generate-a-long-random-secret

# --- OIDC (Keycloak or compatible IdP) ---
KEYCLOAK_CLIENT_ID=your-oidc-client-id
KEYCLOAK_CLIENT_SECRET=your-oidc-client-secret
KEYCLOAK_ISSUER=https://your-auth-host/realms/your-realm

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hosted checkout UI (Filix Checkout or your self-hosted checkout)
NEXT_PUBLIC_CHECKOUT_URL=http://localhost:3001

# --- Optional: portal-only self-host (skip marketing site) ---
# NEXT_PUBLIC_ENABLE_MARKETING=false

# --- Optional runtime ---
# PORT=3000
# HOSTNAME=0.0.0.0

# Portal APIs are called same-origin via /merchant/service (reverse-proxy to FilixPay).
# Configure your reverse proxy / ingress accordingly for production.
